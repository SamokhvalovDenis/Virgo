{
  "name": "virgo-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "test:contact": "node --test tests/contact.test.mjs",
    "test:contact:layout": "node tests/contact-layout.browser.mjs",
    "test:prices:browser": "npm run build && node tests/prices.browser.mjs",
    "dev": "vite",
    "images:optimize": "node scripts/optimize-images.mjs",
    "favicon:generate": "node scripts/generate-favicons.mjs",
    "fonts:optimize": "node scripts/optimize-fonts.mjs",
    "build": "tsc -b && node scripts/build.mjs",
    "lint": "eslint .",
    "preview": "node scripts/preview.mjs",
    "test:readiness:browser": "npm run build && node tests/readiness.browser.mjs",
    "test:seo:browser": "npm run build && node tests/seo.browser.mjs",
    "test:assets:browser": "npm run build && node tests/assets.browser.mjs",
    "test:hero:browser": "npm run build && node tests/hero.browser.mjs",
    "test:about:browser": "npm run build && node tests/about.browser.mjs",
    "test:reviews:browser": "npm run build && node tests/reviews.browser.mjs",
    "test:services:browser": "npm run build && node tests/services.browser.mjs",
    "test:browser": "npm run build && node tests/hero.browser.mjs && node tests/services.browser.mjs && node tests/prices.browser.mjs && node tests/about.browser.mjs && node tests/reviews.browser.mjs && node tests/readiness.browser.mjs && node tests/seo.browser.mjs && node tests/assets.browser.mjs",
    "test:refactor:browser": "npm run build && node tests/refactor.browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
