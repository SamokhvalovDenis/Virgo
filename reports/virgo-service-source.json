      "candidates": [
        {
          "file": "/images/virgo-original/virgo-9f3e933515fe.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_19-44-53.jpg/:/cr=t:12.45%25,l:0%25,w:100%25,h:75.1%25/rs=w:600,h:300,cg:true"
        }
      ],
      "paragraphs": [
        {
          "type": "p",
          "text": "Anticelulitidová masáž pomahá \"vyhladit\" tuto pomerančovou kůru a zlepšit krevní oběh. Tato masáž může zlepšit vzhled celulitidy odstraněním přebytečné tekutiny z těla, redistribuci tukových buněk a zvýšením elasticity pokožky."
        }
      ],
      "listItems": []
    },
    {
      "category": "Masáže",
      "index": 6,
      "title": "Maderoterapie",
      "sourceImage": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_19-57-21.jpg/:/cr=t:10.75%25,l:0%25,w:100%25,h:57.5%25/rs=w:600,h:300,cg:true",
      "exactFile": "/images/virgo-original/virgo-1a1a8b2c68a7.jpg",
      "candidates": [
        {
          "file": "/images/virgo-original/virgo-1a1a8b2c68a7.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_19-57-21.jpg/:/cr=t:10.75%25,l:0%25,w:100%25,h:57.5%25/rs=w:600,h:300,cg:true"
        }
      ],
      "paragraphs": [
        {
          "type": "p",
          "text": "Maderoterapie je unikátní masážní technika, která se provádí pomocí anatomicky tvarovaných devěných válečků."
        },
        {
          "type": "p",
          "text": "Masážní vlastnosti:"
        },
        {
          "type": "p",
          "text": "snižuje objem těla zlepšuje odbourávání tuků podporuje odstraňování toxinů a odpadních látek redukuje projevy celulitidy zvyšuje svalový tonus"
        },
        {
          "type": "p",
          "text": "Pomocí maderoterapie se pokožka stává pružnější a napnutější."
        }
      ],
      "listItems": [
        "snižuje objem těla",
        "zlepšuje odbourávání tuků",
        "podporuje odstraňování toxinů a odpadních látek",
        "redukuje projevy celulitidy",
        "zvyšuje svalový tonus"
      ]
    },
    {
      "category": "Masáže",
      "index": 7,
      "title": "Ayurvédská",
      "sourceImage": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_21-21-55.jpg/:/cr=t:10.67%25,l:0%25,w:100%25,h:76.67%25/rs=w:600,h:300,cg:true",
      "exactFile": "/images/virgo-original/virgo-36d0ce4d8c4c.jpg",
      "candidates": [
        {
          "file": "/images/virgo-original/virgo-36d0ce4d8c4c.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_21-21-55.jpg/:/cr=t:10.67%25,l:0%25,w:100%25,h:76.67%25/rs=w:600,h:300,cg:true"
        }
      ],
      "paragraphs": [
        {
          "type": "p",
          "text": "Ayurvédská olejová masáž je unikátní technika indické masáže, která je založena na hluboké práci s lidskými měkkými tkáněmi. Je považována za nejdůležitější proceduru, schopnou mít uklidňující účinek na celý nervový systém. Ayurvédská masáž umožňuje dosáhnout následujících výsledků:"
        },
        {
          "type": "p",
          "text": "zlepšení krevního oběhu odstranění toxinů z těla zlepšení elasticity svalů a tkání zvýšení pružnosti kloubů pokožka se stává jemnou a lesklou."
        }
      ],
      "listItems": [
        "zlepšení krevního oběhu",
        "odstranění toxinů z těla",
        "zlepšení elasticity svalů a tkání",
        "zvýšení pružnosti kloubů",
        "pokožka se stává jemnou a lesklou."
      ]
    },
    {
      "category": "Masáže",
      "index": 8,
      "title": "Indická masáž hlavy",
      "sourceImage": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_20-36-50.jpg/:/cr=t:0%25,l:17.8%25,w:69.39%25,h:100%25/rs=w:600,h:300,cg:true",
      "exactFile": "/images/virgo-original/virgo-1d773a971214.jpg",
      "candidates": [
        {
          "file": "/images/virgo-original/virgo-2061a0817fbb.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_20-36-50.jpg/:/cr=t:0%25,l:17.8%25,w:69.39%25,h:100%25/rs=w:403,h:202,cg:true"
        },
        {
          "file": "/images/virgo-original/virgo-1d773a971214.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_20-36-50.jpg/:/cr=t:0%25,l:17.8%25,w:69.39%25,h:100%25/rs=w:600,h:300,cg:true"
        },
        {
          "file": "/images/virgo-original/virgo-2cc0564a73ad.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_20-36-50.jpg/:/cr=t:0%25,l:17.8%25,w:69.39%25,h:100%25/rs=w:806,h:403,cg:true"
        },
        {
          "file": "/images/virgo-original/virgo-e102de0da53a.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_20-36-50.jpg/:/cr=t:0%25,l:17.8%25,w:69.39%25,h:100%25/rs=w:980,h:490,cg:true"
        }
      ],
      "paragraphs": [
        {
          "type": "p",
          "text": "Hlava je středem všech myšlenek a činů člověka. Při péči o tělo ona však není zdaleka na prvním místě. Masáž hlavy je nejen užitečná pro každého, ale i přináší spoustu příjemných pocitů. Dosazuje celkovou a místní svalovou relaxaci, snižuje celkovou únavu, depresi a stres, zlepšuje paměť, zvyšuje pracovní kapacitu, snižuje bolest hlavy, obnovuje spánek, normalizuje krevní tlak, zlepšuje sekreční funkci mazových a potních žláz, mikrocirkulaci vlasové pokožky, což pomáhá stimulovat vlasové folikuly."
        }
      ],
      "listItems": []
    },
    {
      "category": "Masáže",
      "index": 9,
      "title": "Thajská masáž nohou",
      "sourceImage": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_20-37-42.jpg/:/cr=t:14.45%25,l:0%25,w:100%25,h:71.09%25/rs=w:600,h:300,cg:true",
      "exactFile": "/images/virgo-original/virgo-822fa23c1df2.jpg",
      "candidates": [
        {
          "file": "/images/virgo-original/virgo-822fa23c1df2.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_20-37-42.jpg/:/cr=t:14.45%25,l:0%25,w:100%25,h:71.09%25/rs=w:600,h:300,cg:true"
        }
      ],
      "paragraphs": [
        {
          "type": "p",
          "text": "Technika provádění thajské masáže nohou je považována za jednu z nejstarších technik, která k nám přišla z východní Asie a dokázala si získat důvěru Evropanů. Thajská masáž nohou je umění doteku, které je zaměřeno na obnovení energetické rovnováhy těla a probuzení jeho vnitřních zásob. Tento typ masáže je založen na teorii vnějších linií, které procházejí chodidly a odrážejí stav celého těla. Provádí se pomocí dřevěných tyčinek zaměřených na vypracování aktivních bodů,"
        }
      ],
      "listItems": []
    },
    {
      "category": "Depilace",
      "index": 0,
      "title": "Depilace cukrovou pastou (sugaring)",
      "sourceImage": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-12-01_11-17-47.jpg/:/cr=t:14.29%25,l:0%25,w:100%25,h:71.43%25/rs=w:600,h:300,cg:true",
      "exactFile": "/images/virgo-original/virgo-0f0fb8661ddc.jpg",
      "candidates": [
        {
          "file": "/images/virgo-original/virgo-0f0fb8661ddc.jpg",
          "url": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-12-01_11-17-47.jpg/:/cr=t:14.29%25,l:0%25,w:100%25,h:71.43%25/rs=w:600,h:300,cg:true"
        }
      ],
      "paragraphs": [
        {
          "type": "p",
          "text": "Chloupky odstraňujeme pžírodní cukrovou pastou."
        },
        {
