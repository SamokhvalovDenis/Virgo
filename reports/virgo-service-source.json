      "index": 1,
      "title": "Medová a detoxikační",
      "sourceImage": "https://img1.wsimg.com/isteam/ip/278f614d-3dab-400e-930c-42a16d1e6ea0/photo_2024-10-28_17-31-20.jpg/:/cr=t:12.52%25,l:0%25,w:100%25,h:74.96%25/rs=w:600,h:300,cg:true",
