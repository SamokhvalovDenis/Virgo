# All VITE_* values are PUBLIC and embedded at build time, not Worker runtime.
# Rebuild after changing them. The current origin and public access key also
# have defaults in source, so a clean Cloudflare build needs no extra variables.
VITE_SITE_URL=https://virgo.beautycz.workers.dev
VITE_WEB3FORMS_ACCESS_KEY=2230598f-5e86-432e-8e9d-4a6651ab4b83

# production (default) | mock (development only) | disabled (explicit off switch)
# For local tests copy to .env.local and change this value to mock.
# A production build ignores mock and uses the real API unless disabled.
VITE_CONTACT_MODE=production
VITE_CONTACT_MOCK_RESULT=success

# Optional approved, existing privacy page.
VITE_CONTACT_PRIVACY_URL=

# Free hCaptcha uses Web3Forms' shared public site key from source.
# Enable hCaptcha / Block Spam in the Web3Forms dashboard for server enforcement.
# No Resend, Turnstile, server secrets or /api/contact endpoint are needed.
