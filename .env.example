# All VITE_* values are PUBLIC and are embedded in the browser build.
# Approved canonical https origin, no path/trailing slash. Leave empty until chosen.
# Rebuild after choosing or changing the domain.
VITE_SITE_URL=

# disabled | mock (development only) | production (explicit opt-in)
# Copy to .env.local and set mock for local tests. Never use a secret here.
VITE_CONTACT_MODE=disabled
VITE_CONTACT_MOCK_RESULT=success

# Real form requires BOTH values and production mode. No invented privacy page.
VITE_CONTACT_PRIVACY_URL=
VITE_TURNSTILE_SITE_KEY=

# Cloudflare Pages runtime variables / secrets, NOT Vite build values.
# Put real local secrets in ignored .dev.vars, or in Cloudflare Dashboard.
# CONTACT_ENABLED=true only after privacy, sender, Turnstile and abuse rules are ready.
CONTACT_ENABLED=false
CONTACT_ALLOWED_ORIGIN=
CONTACT_PRIVACY_URL=
CONTACT_FROM=
CONTACT_TO=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
